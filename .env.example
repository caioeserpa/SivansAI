# Credenciais e conexão MinIO
MINIO_ROOT_USER=admin
MINIO_ROOT_PASSWORD=miniopassword
MINIO_ENDPOINT=localhost:9000
MINIO_VOLUME=./backup_minio_data
MINIO_BUCKET_BRONZE=bronze
MINIO_BUCKET_SILVER=silver

# Qdrant
QDRANT_STORAGE=./qdrant_storage
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_COLLECTION=documentos_acervo

# Ollama e Modelos
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b-instruct
EMBED_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2

# Pastas e Banco
ACERVO_DIR=./acervo
API_URL=http://localhost:8000
HISTORICO_DB_PATH=./historico.db

# Configurações do Pipeline / RAG
REFORMULAR_PERGUNTAS=True
TROCAS_PARA_REFORMULAR=3
WATCHER_SEGUNDOS_ESTAVEL=2
